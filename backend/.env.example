# Server
PORT=3001

# CORS / Socket.io — comma-separated list of allowed browser origins.
# Example: CORS_ALLOWED_ORIGINS=https://chat.example.com,https://www.example.com
# Falls back to FRONTEND_URL, then to http://localhost:3000 for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SECURITY: number of reverse-proxy hops in front of this app (nginx, Cloudflare...).
# ONLY set this when the app IS behind a proxy. Leaving it 0 (default) makes the
# server ignore X-Forwarded-For so clients cannot spoof their IP. Behind a proxy,
# set it to the number of trusted hops (usually 1) so IP blocking/rate limiting
# see the real client address.
TRUST_PROXY_HOPS=0

# SECURITY: block outbound webhook dispatches to private/loopback/metadata
# addresses (SSRF protection). Set to false ONLY if your n8n or other webhook
# targets intentionally live on an internal network — you then own that risk.
# Link-local metadata (169.254.169.254) is always blocked.
BLOCK_PRIVATE_WEBHOOKS=true

# JWT
# SECURITY: the server refuses to start with a missing or placeholder secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PASTE_A_RANDOM_64_PLUS_CHAR_SECRET_HERE
JWT_EXPIRES_IN=7d

# Database (Sequelize)
# For MySQL:
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=targetchat
DB_USER=root
DB_PASS=

# For SQLite (fallback) set DB_DIALECT=sqlite and provide path
#DB_DIALECT=sqlite
#DB_STORAGE=./data/targetchat.sqlite

# n8n webhook URL
N8N_WEBHOOK_URL=https://my-n8n-server.com/webhook/targetchat

# File Security
# SECURITY: required — signed file URLs are forgeable without a strong secret.
FILE_SIGN_SECRET=PASTE_A_RANDOM_64_PLUS_CHAR_SECRET_HERE
FILE_URL_EXPIRE_SECONDS=60

# Webhook Security (n8n -> backend callbacks)
# SECURITY: required — the /api/webhook/n8n receiver rejects all calls without it.
WEBHOOK_SECRET=PASTE_A_RANDOM_64_PLUS_CHAR_SECRET_HERE

# PayPal webhook verification (verify-webhook-signature API)
# SECURITY: required to accept PayPal events — unverified events are rejected.
# PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# PAYPAL_MODE=sandbox  # or 'live'
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=

# Email System Configuration
EMAIL_PROVIDER=smtp  # Options: 'smtp', 'sendgrid', 'ses'

# SMTP Configuration (if using EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SendGrid (if using EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# AWS SES (if using EMAIL_PROVIDER=ses)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=AKIA...
AWS_SES_SECRET_KEY=xxxxx...

# Email Sender Addresses
EMAIL_FROM_NOREPLY=no-reply@targetchat.com
EMAIL_FROM_SYSTEM=system@targetchat.com
EMAIL_FROM_BILLING=billing@targetchat.com
EMAIL_FROM_WORKFLOWS=workflows@targetchat.com

# Redis (for email queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Support Email
SUPPORT_EMAIL=support@targetchat.com

# Public backend base URL used to build webhook URLs on Admin > Channels.
# Meta requires a public HTTPS URL (e.g. https://api.example.com).
# Localhost is development-only and triggers a configuration warning.
# BACKEND_URL=https://api.example.com
# PUBLIC_BASE_URL=https://api.example.com

# Meta / Omnichannel (Admin > Channels reads status only — values never leave the server)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_SYSTEM_USER_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=

