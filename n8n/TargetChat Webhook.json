        "jsCode": "// Build URL\nconst url = \"http://host.docker.internal:3001\" + $json.body.message.url;\n\nconsole.log(\"Downloading from:\", url);\n\n// Download with n8n's built-in helper\nconst response = await this.helpers.httpRequest({\n  method: 'GET',\n  url: url,\n  encoding: 'arraybuffer',\n  json: false,\n  returnFullResponse: true\n});\n\nconst filename = $json.body.message.filename || \"file.bin\";\nconst contentType = $json.body.message.contentType || \"application/octet-stream\";\n\nreturn {\n  json: {\n    filename,\n    contentType,\n    size: response.body.length,\n    downloaded: true\n  },\n  binary: {\n    data: {\n      data: Buffer.from(response.body),\n      mimeType: contentType,\n      fileName: filename\n    }\n  }\n};"
