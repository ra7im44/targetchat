# ---------------------------------------------------------------------------
# TargetChat — Docker Compose environment
# Copy to .env and replace every placeholder before `docker compose up`.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Database (MariaDB container) ---
DB_NAME=targetchat
DB_USER=targetuser
MARIADB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# --- Redis (email queue + Socket.io adapter) ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# --- Application secrets (required, min 32 chars) ---
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
FILE_SIGN_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
WEBHOOK_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# --- Browser-facing URLs ---
# Must be reachable from the browser, not from inside Docker.
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Local AI (Ollama on the host) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
AI_STREAMING_ENABLED=true
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_TOKENS=700
# Canned replies are disabled by default; real models only.
AI_ALLOW_FALLBACK=false
# Optional: comma-separated fallback providers (only configured ones are used).
# AI_FALLBACK_ORDER=openai,anthropic
# Optional local embedding model for the knowledge base (must be pulled first):
# AI_EMBED_MODEL=nomic-embed-text

# --- Paid providers: leave empty until real credentials exist ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Billing ---
# Mock activation is hard-disabled when NODE_ENV=production; this flag is an
# additional explicit gate for non-production demos.
ALLOW_MOCK_BILLING=false
PAYPAL_WEBHOOK_ID=

# --- Email (use the `email` compose profile for Mailpit) ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
